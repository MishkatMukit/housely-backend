<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password Reset Successful</title>
</head>

<body style="margin:0; padding:0; background:#f4f8f7; font-family:Arial, Helvetica, sans-serif; color:#1f2937;">

  <div style="
    max-width:600px;
    margin:40px auto;
    background:#ffffff;
    border-radius:16px;
    overflow:hidden;
    box-shadow:0 8px 30px rgba(0,0,0,0.08);
  ">

    <!-- Header -->
    <div style="
      background:#0f766e;
      padding:32px 30px;
      text-align:center;
    ">
      <div style="
        font-size:28px;
        font-weight:700;
        color:#ffffff;
      ">
        Password Updated
      </div>

      <div style="
        margin-top:8px;
        font-size:14px;
        color:#d1fae5;
      ">
        Your account is secure
      </div>
    </div>

    <!-- Content -->
    <div style="padding:36px 30px; text-align:center;">

      <!-- Success Indicator -->
      <div style="
        width:72px;
        height:72px;
        line-height:72px;
        margin:0 auto 24px;
        background:#ecfdf5;
        border:2px solid #99f6e4;
        border-radius:50%;
        font-size:34px;
        font-weight:bold;
        color:#0f766e;
      ">
        ✓
      </div>

      <h2 style="
        margin:0 0 14px;
        font-size:22px;
        color:#134e4a;
      ">
        Password Reset Successful
      </h2>

      <% if (locals.userName) { %>

        <p style="
          margin:0 auto 24px;
          max-width:480px;
          font-size:15px;
          line-height:1.7;
          color:#4b5563;
        ">
          You're all set, <strong style="color:#134e4a;"><%= userName %></strong>.
          Your password has been successfully updated and your account is now secured with your new password.
        </p>

      <% } else { %>

        <p style="
          margin:0 auto 24px;
          max-width:480px;
          font-size:15px;
          line-height:1.7;
          color:#4b5563;
        ">
          Your password has been successfully updated.
          Your account is now secured with your new password.
        </p>

      <% } %>

      <!-- Security Notice -->
      <div style="
        background:#f0fdfa;
        border:1px solid #ccfbf1;
        border-radius:10px;
        padding:16px;
        margin:0 0 28px;
        text-align:left;
      ">
        <div style="
          font-size:14px;
          font-weight:700;
          color:#0f766e;
          margin-bottom:6px;
        ">
          Account Security
        </div>

        <div style="
          font-size:13px;
          line-height:1.6;
          color:#6b7280;
        ">
          If you did not make this change, please contact the support team immediately to help protect your account.
        </div>
      </div>

      <!-- Login Button -->
      <a
        href="<%= locals.loginUrl ? loginUrl : '/login' %>"
        style="
          display:inline-block;
          background:#0f766e;
          color:#ffffff;
          text-decoration:none;
          padding:14px 30px;
          border-radius:8px;
          font-size:15px;
          font-weight:600;
        "
      >
        Continue to Login
      </a>

    </div>

    <!-- Footer -->
    <div style="
      background:#f8fafc;
      border-top:1px solid #e5e7eb;
      padding:20px;
      text-align:center;
      font-size:12px;
      color:#9ca3af;
    ">
      Secure Patient Healthcare Management System
    </div>

  </div>

</body>
</html>