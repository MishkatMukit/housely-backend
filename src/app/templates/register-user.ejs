<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Registration</title>
</head>

<body style="margin:0; padding:0; background:#f4f8f7; font-family:Arial, Helvetica, sans-serif; color:#1f2937;">

  <div style="max-width:600px; margin:40px auto; background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 8px 30px rgba(0,0,0,0.08);">

    <!-- Header -->
    <div style="background:#0f766e; padding:32px 30px; text-align:center;">
      <div style="font-size:28px; font-weight:700; color:#ffffff;">
        User Registration
      </div>
      <div style="margin-top:8px; font-size:14px; color:#d1fae5;">
        Verify your email to continue
      </div>
    </div>

    <!-- Content -->
    <div style="padding:36px 30px;">

      <h2 style="margin:0 0 14px; font-size:22px; color:#134e4a;">
        Hello, <%= name %>
      </h2>

      <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#4b5563;">
        Thank you for registering with us. Please use the verification code below
        to complete your User Registration.
      </p>

      <!-- User Email -->
      <div style="background:#f0fdfa; border:1px solid #ccfbf1; border-radius:10px; padding:14px 18px; margin-bottom:24px;">
        <div style="font-size:12px; color:#6b7280; margin-bottom:4px;">
          REGISTERED EMAIL
        </div>
        <div style="font-size:15px; font-weight:600; color:#134e4a;">
          <%= email %>
        </div>
      </div>

      <!-- OTP -->
      <div style="text-align:center; margin:28px 0;">
        <div style="font-size:13px; color:#6b7280; margin-bottom:12px;">
          YOUR VERIFICATION CODE
        </div>

        <div style="
          display:inline-block;
          background:#ecfdf5;
          border:2px dashed #14b8a6;
          border-radius:12px;
          padding:16px 28px;
          font-size:32px;
          font-weight:700;
          letter-spacing:8px;
          color:#0f766e;
          white-space:nowrap;
        "><%= otpValue %></div>
      </div>

      <!-- Expiration -->
      <div style="
        background:#fff7ed;
        border-left:4px solid #f97316;
        padding:14px 16px;
        border-radius:6px;
        font-size:14px;
        line-height:1.5;
        color:#9a3412;
      ">
        This verification code will expire in
        <strong><%= expirationTime %></strong>.
      </div>

      <p style="margin:24px 0 0; font-size:13px; line-height:1.6; color:#6b7280;">
        For your security, please do not share this verification code with anyone.
      </p>

    </div>

    <!-- Footer -->
    <div style="
      background:#f8fafc;
      border-top:1px solid #e5e7eb;
      padding:20px;
      text-align:center;
      font-size:12px;
      color:#9ca3af;
    ">
      Housely Registration System
    </div>

  </div>

</body>
</html>
