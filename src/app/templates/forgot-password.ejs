<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password Reset Verification</title>
</head>

<body style="margin:0; padding:0; background:#f4f8f7; font-family:Arial, Helvetica, sans-serif; color:#1f2937;">

  <div style="
    max-width:600px;
    margin:40px auto;
    background:#ffffff;
    border-radius:16px;
    overflow:hidden;
    box-shadow:0 8px 30px rgba(0,0,0,0.08);
  ">

    <!-- Header -->
    <div style="
      background:#0f766e;
      padding:32px 30px;
      text-align:center;
    ">
      <div style="
        font-size:28px;
        font-weight:700;
        color:#ffffff;
      ">
        Password Reset
      </div>

      <div style="
        margin-top:8px;
        font-size:14px;
        color:#d1fae5;
      ">
        Verify your identity to continue
      </div>
    </div>


    <!-- Content -->
    <div style="padding:36px 30px;">

      <!-- Greeting -->
      <h2 style="
        margin:0 0 14px;
        font-size:22px;
        color:#134e4a;
      ">
        Hello<% if (typeof name !== 'undefined' && name) { %>, <%= name %><% } %>
      </h2>


      <!-- Description -->
      <p style="
        margin:0 0 24px;
        font-size:15px;
        line-height:1.7;
        color:#4b5563;
      ">
        We received a request to reset the password for your account.
        Please use the verification code below to continue.
      </p>


      <!-- Account Information -->
      <% if (typeof email !== 'undefined' && email) { %>
        <div style="
          background:#f0fdfa;
          border:1px solid #ccfbf1;
          border-radius:10px;
          padding:14px 18px;
          margin-bottom:24px;
        ">
          <div style="
            font-size:12px;
            color:#6b7280;
            margin-bottom:4px;
          ">
            ACCOUNT EMAIL
          </div>

          <div style="
            font-size:15px;
            font-weight:600;
            color:#134e4a;
          ">
            <%= email %>
          </div>
        </div>
      <% } %>


      <!-- OTP -->
      <div style="
        text-align:center;
        margin:28px 0;
      ">

        <div style="
          font-size:13px;
          color:#6b7280;
          margin-bottom:12px;
          font-weight:600;
          letter-spacing:0.5px;
        ">
          VERIFICATION CODE
        </div>

        <div style="
          display:inline-block;
          background:#ecfdf5;
          border:2px dashed #14b8a6;
          border-radius:12px;
          padding:16px 28px;
          font-size:32px;
          font-weight:700;
          letter-spacing:8px;
          color:#0f766e;
          white-space:nowrap;
        "><%= otp %></div>

      </div>


      <!-- Expiration Notice -->
      <div style="
        background:#fff7ed;
        border-left:4px solid #f97316;
        padding:14px 16px;
        border-radius:6px;
        font-size:14px;
        line-height:1.5;
        color:#9a3412;
        margin-bottom:24px;
      ">
        This verification code will expire in
        <strong>5 Minutes</strong>.
      </div>


      <!-- Security Notice -->
      <div style="
        background:#f8fafc;
        border:1px solid #e5e7eb;
        border-radius:10px;
        padding:16px;
      ">
        <div style="
          font-size:14px;
          font-weight:700;
          color:#134e4a;
          margin-bottom:6px;
        ">
          Didn't request a password reset?
        </div>

        <div style="
          font-size:13px;
          line-height:1.6;
          color:#6b7280;
        ">
          You can safely ignore this email. Your current password will remain unchanged.
        </div>
      </div>

    </div>


    <!-- Footer -->
    <div style="
      background:#f8fafc;
      border-top:1px solid #e5e7eb;
      padding:20px;
      text-align:center;
      font-size:12px;
      color:#9ca3af;
    ">
      Secure Patient Healthcare Management System
    </div>

  </div>

</body>
</html>