<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Housely — Lease Created</title>
</head>
<body style="margin:0; padding:0; background:#f4f8f7; font-family:Arial, Helvetica, sans-serif; color:#1f2937;">
  <div style="max-width:600px; margin:40px auto; background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 8px 30px rgba(0,0,0,0.08);">
    <div style="background:#0f766e; padding:32px 30px; text-align:center;">
      <div style="font-size:28px; font-weight:700; color:#ffffff;">Your Lease Is Ready</div>
      <div style="margin-top:8px; font-size:14px; color:#d1fae5;">Housely Property Management System</div>
    </div>
    <div style="padding:36px 30px;">
      <h2 style="margin:0 0 14px; font-size:22px; color:#134e4a;">Hello, <%= name %></h2>
      <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#4b5563;">
        Great news! A lease has been created for you. Please review the details below and
        make the required payments to activate your tenancy.
      </p>
      <div style="background:#ecfdf5; border-left:4px solid #14b8a6; border-radius:6px; padding:16px; margin-bottom:24px;">
        <div style="font-size:15px; font-weight:700; color:#0f766e; margin-bottom:5px;">Lease Details</div>
        <div style="font-size:14px; line-height:1.6; color:#4b5563;">
          <%= reason %>
        </div>
      </div>
      <p style="margin:0; font-size:14px; line-height:1.7; color:#6b7280;">
        If you have any questions, please contact the property owner or our support team.
      </p>
    </div>
    <div style="background:#f8fafc; border-top:1px solid #e5e7eb; padding:20px; text-align:center; font-size:12px; color:#9ca3af;">
      Housely Property Management System
    </div>
  </div>
</body>
</html>