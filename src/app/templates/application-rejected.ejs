<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Application Not Approved</title>
</head>

<body style="margin:0; padding:0; background:#f4f8f7; font-family:Arial, Helvetica, sans-serif; color:#1f2937;">

  <div style="max-width:600px; margin:40px auto; background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 8px 30px rgba(0,0,0,0.08);">

<!-- Header -->
<div style="background:#b91c1c; padding:32px 30px; text-align:center;">
  <div style="font-size:28px; font-weight:700; color:#ffffff;">
    Application Not Approved
  </div>

  <div style="margin-top:8px; font-size:14px; color:#fee2e2;">
    An update regarding your owner application
  </div>
</div>

<!-- Content -->
<div style="padding:36px 30px;">

  <h2 style="margin:0 0 14px; font-size:22px; color:#7f1d1d;">
    Hello, <%= name %>
  </h2>

  <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#4b5563;">
    Thank you for your interest in becoming a property owner on
    <strong style="color:#b91c1c;">Housely</strong>.
    After reviewing your application, we regret to inform you
    that it has not been approved at this time.
  </p>

  <!-- Rejection Reason -->
  <div style="
    background:#fff7ed;
    border:1px solid #fed7aa;
    border-radius:10px;
    padding:18px;
    margin-bottom:24px;
  ">

    <div style="
      font-size:12px;
      font-weight:700;
      letter-spacing:0.5px;
      color:#6b7280;
      margin-bottom:10px;
    ">
      REASON FOR DECISION
    </div>

    <div style="
      font-size:14px;
      line-height:1.7;
      color:#4b5563;
    ">
      <%= reason %>
    </div>

  </div>

  <!-- Status Message -->
  <div style="
    background:#fef2f2;
    border-left:4px solid #ef4444;
    border-radius:6px;
    padding:16px;
    margin-bottom:24px;
  ">

    <div style="
      font-size:15px;
      font-weight:700;
      color:#b91c1c;
      margin-bottom:5px;
    ">
      Application Not Approved
    </div>

    <div style="
      font-size:14px;
      line-height:1.6;
      color:#4b5563;
    ">
      Please review the reason provided above. You may correct the
      issues and resubmit your application, or contact the
      platform administration team if you have questions regarding
      this decision.
    </div>

  </div>

  <p style="margin:0; font-size:14px; line-height:1.7; color:#6b7280;">
    Thank you for your time and understanding.
  </p>

</div>

<!-- Footer -->
<div style="
  background:#f8fafc;
  border-top:1px solid #e5e7eb;
  padding:20px;
  text-align:center;
  font-size:12px;
  color:#9ca3af;
">
  Housely Property Management System
</div>

  </div>

</body>

</html>
