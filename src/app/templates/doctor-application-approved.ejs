<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Doctor Application Approved</title>
</head>

<body style="margin:0; padding:0; background:#f4f8f7; font-family:Arial, Helvetica, sans-serif; color:#1f2937;">

  <div style="max-width:600px; margin:40px auto; background:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 8px 30px rgba(0,0,0,0.08);">

```
<!-- Header -->
<div style="background:#0f766e; padding:32px 30px; text-align:center;">
  <div style="font-size:28px; font-weight:700; color:#ffffff;">
    Application Approved
  </div>

  <div style="margin-top:8px; font-size:14px; color:#d1fae5;">
    Welcome to our healthcare platform
  </div>
</div>

<!-- Content -->
<div style="padding:36px 30px;">

  <h2 style="margin:0 0 14px; font-size:22px; color:#134e4a;">
    Hello, <%= name %>
  </h2>

  <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#4b5563;">
    We're pleased to inform you that your doctor application has been reviewed
    and approved successfully.
  </p>

  <!-- Approval Message -->
  <div style="
    background:#ecfdf5;
    border-left:4px solid #14b8a6;
    border-radius:6px;
    padding:16px;
    margin-bottom:24px;
  ">
    <div style="
      font-size:15px;
      font-weight:700;
      color:#0f766e;
      margin-bottom:5px;
    ">
      Application Approved
    </div>

    <div style="
      font-size:14px;
      line-height:1.6;
      color:#4b5563;
    ">
      Your application has been approved. You can now access your doctor account
      and use the healthcare platform's doctor features.
    </div>
  </div>

  <p style="margin:0; font-size:14px; line-height:1.7; color:#6b7280;">
    Thank you for joining our platform. We look forward to having you as part
    of our healthcare community.
  </p>

</div>

<!-- Footer -->
<div style="
  background:#f8fafc;
  border-top:1px solid #e5e7eb;
  padding:20px;
  text-align:center;
  font-size:12px;
  color:#9ca3af;
">
  Secure Patient Healthcare Management System
</div>

  </div>

</body>

</html>
