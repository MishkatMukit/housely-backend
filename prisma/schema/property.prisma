model Property {
  id              String    @id @default(uuid())
  ownerId         String
  
  title           String
  description     String?
  address         String
  city            String
  district        String
  postalCode      String?
  
  totalRooms      Int
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  owner           Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rooms           Room[]

  @@index([ownerId])
  @@map("properties")
}