model Property {
  id              String    @id @default(uuid())
  ownerId         String
  
  title           String
  description     String?
  address         String
  city            String
  district        String
  postalCode      String?
  companyName     String?
  
  totalFlats      Int
  images          Json?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  owner           Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  variants        FlatVariant[]
  flats           Flat[]

  @@index([ownerId])
  @@map("properties")
}