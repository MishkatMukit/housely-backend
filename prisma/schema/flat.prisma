model FlatVariant {
  id            String   @id @default(uuid())
  propertyId    String
  name          String
  bedrooms      Int
  bathrooms     Int
  sizeSqft      Int?
  rentAmount    Decimal  @db.Decimal(15, 2)
  advanceAmount Decimal  @db.Decimal(15, 2)
  totalUnits    Int
  images        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  flats         Flat[]

  @@index([propertyId])
  @@map("flat_variants")
}

model Flat {
  id              String        @id @default(uuid())
  propertyId      String
  variantId       String
  flatNumber      String
  status          FlatStatus    @default(AVAILABLE)
  rentOverride    Decimal?      @db.Decimal(15, 2)
  advanceOverride Decimal?      @db.Decimal(15, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  variant         FlatVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  leases          Lease[]

  @@unique([propertyId, flatNumber])
  @@index([propertyId])
  @@index([variantId])
  @@index([status])
  @@map("flats")
}
